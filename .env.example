# Supabase (each value must belong to the same Staging or Production project)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
# Modern public key beginning sb_publishable_ (existing variable name retained for compatibility)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_sb_publishable_key
# Server-side ONLY: modern privileged key beginning sb_secret_
SUPABASE_SECRET_KEY=your_sb_secret_key

# App URL (used for auth redirect links)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional legacy name (avoid if possible)
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Email (optional, only if you use /api/contact/send)
RESEND_API_KEY=your_resend_api_key
MAIL_FROM="Atom Jiu-Jitsu <no-reply@yourdomain.com>"

# Website → ATOM Prospects real-time intake (server-side only)
# Use the exact same secret in the WordPress ATOM Prospects plugin settings.
ATOM_PROSPECTS_WEBHOOK_SECRET=replace_with_a_long_random_secret
